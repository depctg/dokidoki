{
  "schemaVersion": 1,
  "id": "manhuagui",
  "name": "漫画柜 · Manhuagui",
  "version": 8,
  "allowedHosts": [
    "www.manhuagui.com",
    "cf.mhgui.com",
    "i.hamreus.com",
    "eu.hamreus.com",
    "eu1.hamreus.com",
    "eu2.hamreus.com",
    "us.hamreus.com",
    "us1.hamreus.com",
    "us2.hamreus.com",
    "us3.hamreus.com"
  ],
  "matchers": [
    {
      "kind": "directory",
      "pattern": "^https://www\\.manhuagui\\.com/(|list/.*|update/.*|s/.*)$",
      "priority": 0
    },
    {
      "kind": "manga",
      "pattern": "^https://www\\.manhuagui\\.com/(comic|book)/[0-9]+/$",
      "priority": 0
    },
    {
      "kind": "chapter",
      "pattern": "^https://www\\.manhuagui\\.com/(comic|book)/[0-9]+/[0-9]+\\.html$",
      "priority": 0
    }
  ],
  "searchURLTemplate": "https://www.manhuagui.com/s/{query}.html",
  "extractors": {
    "directory": {
      "format": "html",
      "fields": {
        "title": {
          "path": "//title"
        },
        "mangaLinks": {
          "path": "//a[starts-with(@href,\"/comic/\") or starts-with(@href,\"/book/\")]",
          "read": "attr:href"
        },
        "next": {
          "path": "//div[@class=\"pager\"]/a[normalize-space(.)=\"下一页\"]",
          "read": "attr:href"
        },
        "sortByLinks": {
          "path": "//div[contains(concat(\" \",normalize-space(@class),\" \"),\" book-sort \")]//li/a",
          "read": "attr:href"
        },
        "selectedSortBy": {
          "path": "//div[contains(concat(\" \",normalize-space(@class),\" \"),\" book-sort \")]//li[@class=\"current\" or @class=\"selected\"]/a",
          "read": "attr:href"
        }
      }
    },
    "manga": {
      "format": "html",
      "fields": {
        "title": {
          "path": "//h1"
        },
        "author": {
          "path": "//li[contains(.,\"漫画作者\")]/a"
        },
        "summary": {
          "path": "//*[@id=\"intro-all\"]"
        },
        "coverImage": {
          "path": "//div[contains(@class,\"book-cover\")]//img",
          "read": "attr:src"
        },
        "rating": {
          "path": "//div[@id=\"scoreRes\"]//p[@class=\"score-avg\"]/em",
          "regex": "^\\d+(?:\\.\\d+)?$",
          "group": 0
        },
        "status": {
          "path": "//ul[contains(@class,\"detail-list\")]/li[@class=\"status\"]/span/span[1]"
        },
        "tags": {
          "path": "//ul[contains(@class,\"detail-list\")]//span[strong[contains(.,\"漫画剧情\")]]/a"
        },
        "chapterLists": {
          "path": "//div[contains(concat(' ',normalize-space(@class),' '),' chapter-list ')]",
          "fields": {
            "title": {
              "path": "preceding-sibling::h4[1]/span"
            },
            "chapterLinks": {
              "path": ".//a",
              "read": "attr:href",
              "reverse": true
            }
          }
        }
      }
    },
    "chapter": {
      "format": "renderedJSON",
      "rendering": {
        "contentMode": "desktop",
        "captureFunction": "SMH.imgData",
        "readyImageXPath": "//*[@id=\"mangaFile\"]"
      },
      "variables": {
        "cdn": {
          "path": "imageURL",
          "regex": "^(https?://[^/]+)",
          "group": 1
        }
      },
      "fields": {
        "title": {
          "path": "data.cname"
        },
        "mangaLink": {
          "path": "data.bid",
          "urlTemplate": "https://www.manhuagui.com/comic/{value}/"
        },
        "pageImages": {
          "path": "data.files.*",
          "urlTemplate": "{vars.cdn}{data.path}{value}",
          "queryPath": "data.sl"
        }
      }
    }
  },
  "browse": [
    {
      "title": "最近更新",
      "url": "https://www.manhuagui.com/update/"
    },
    {
      "title": "漫画大全",
      "url": "https://www.manhuagui.com/list/"
    },
    {
      "title": "冒险漫画",
      "url": "https://www.manhuagui.com/list/maoxian/"
    }
  ]
}
