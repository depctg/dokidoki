{
  "schemaVersion": 1,
  "id": "mangacopy",
  "name": "拷貝漫畫 · MangaCopy",
  "version": 4,
  "allowedHosts": [
    "www.mangacopy.com",
    "s0.mangafunb.fun",
    "s3.mangafunb.fun",
    "sb.mangafunb.fun",
    "sc.mangafunb.fun",
    "sd.mangafunb.fun",
    "sf.mangafunb.fun",
    "sg.mangafunb.fun",
    "sh.mangafunb.fun",
    "sj.mangafunb.fun",
    "sl.mangafunb.fun",
    "sm.mangafunb.fun",
    "sn.mangafunb.fun",
    "sq.mangafunb.fun",
    "sr.mangafunb.fun",
    "ss.mangafunb.fun",
    "st.mangafunb.fun",
    "sw.mangafunb.fun",
    "sx.mangafunb.fun",
    "sy.mangafunb.fun",
    "sz.mangafunb.fun"
  ],
  "matchers": [
    {
      "kind": "directory",
      "pattern": "^https://www\\.mangacopy\\.com/(comics|search)(\\?.*)?$",
      "priority": 0
    },
    {
      "kind": "directory",
      "pattern": "^https://www\\.mangacopy\\.com/api/kb/web/searchcl/comics\\?.*$",
      "priority": 0,
      "extractor": "search"
    },
    {
      "kind": "manga",
      "pattern": "^https://www\\.mangacopy\\.com/comic/[^/?]+$",
      "priority": 0
    },
    {
      "kind": "chapter",
      "pattern": "^https://www\\.mangacopy\\.com/comic/[^/?]+/chapter/[^/?]+$",
      "priority": 0
    }
  ],
  "extractors": {
    "directory": {
      "format": "renderedHTML",
      "rendering": {
        "readyXPath": "//div[contains(@class,'exemptComic-box')]//a[contains(@href,'/comic/')] | //div[@id='comic']//a[contains(@href,'/comic/')] | //*[@id='comic']//li[@class='page-total' and normalize-space(.)='/0']",
        "contentMode": "desktop"
      },
      "fields": {
        "title": {
          "path": "//title"
        },
        "mangaLinks": {
          "path": "//div[contains(@class,'exemptComic-box')]//a[contains(@href,'/comic/') and normalize-space(.)!=''] | //div[@id='comic']//a[contains(@href,'/comic/') and normalize-space(.)!='']",
          "read": "attr:href"
        },
        "next": {
          "path": "//li[@class='next']/a[starts-with(@href,'/comics?')]",
          "read": "attr:href"
        },
        "sortByLinks": {
          "path": "//dl[dt[contains(.,'排序')]]//a",
          "read": "attr:href"
        }
      }
    },
    "manga": {
      "format": "renderedHTML",
      "rendering": {
        "readyXPath": "//div[contains(@class,'upLoop')]//div[contains(@class,'tab-content')]//a[contains(@href,'/chapter/')]",
        "contentMode": "desktop"
      },
      "fields": {
        "title": {
          "path": "//h6[@title]"
        },
        "author": {
          "path": "//span[contains(@class,'comicParticulars-right-txt')][a[contains(@href,'/author/')]]"
        },
        "coverImage": {
          "path": "//div[contains(@class,'comicParticulars-left-img')]/img",
          "read": "attr:data-src",
          "fallback": "attr:src"
        },
        "summary": {
          "path": "//p[@class=\"intro\"]"
        },
        "status": {
          "path": "//li[span[contains(.,'狀態')]]/span[contains(@class,'comicParticulars-right-txt')]"
        },
        "tags": {
          "path": "//span[contains(@class,'comicParticulars-tag')]/a",
          "regex": "^#?(.*)$",
          "group": 1
        },
        "chapterLinks": {
          "path": "//div[contains(@class,'upLoop')]//div[contains(@class,'tab-content')]//a[contains(@href,'/chapter/')]",
          "read": "attr:href"
        }
      }
    },
    "chapter": {
      "rendering": {
        "contentMode": "desktop",
        "readyXPath": "//span[@class='comicCount' and number(.) > 0]"
      },
      "session": {
        "mode": "scroll",
        "actionXPath": "//ul[contains(@class,'comicContent-list')]/li[1]"
      },
      "fields": {
        "title": {
          "path": "//title",
          "regex": "^.*? - (.*?) - ",
          "group": 1
        },
        "mangaLink": {
          "path": "//div[contains(@class,'comicContent-prev') and contains(@class,'list')]/a",
          "read": "attr:href"
        },
        "totalCount": {
          "path": "//span[@class='comicCount']"
        },
        "pageImages": {
          "path": "//ul[contains(@class,'comicContent-list')]//img",
          "read": "attr:data-src"
        }
      }
    },
    "search": {
      "format": "json",
      "fields": {
        "title": {
          "path": "message"
        },
        "mangaLinks": {
          "path": "results.list.*",
          "read": "attr:path_word",
          "titlePath": "name",
          "urlTemplate": "https://www.mangacopy.com/comic/{value}"
        }
      },
      "pagination": {
        "offset": "results.offset",
        "limit": "results.limit",
        "total": "results.total",
        "parameter": "offset"
      }
    }
  },
  "browse": [
    {
      "title": "最近更新",
      "url": "https://www.mangacopy.com/comics"
    },
    {
      "title": "熱門漫畫",
      "url": "https://www.mangacopy.com/comics?ordering=-popular"
    },
    {
      "title": "已完結",
      "url": "https://www.mangacopy.com/comics?status=1"
    }
  ],
  "searchURLTemplate": "https://www.mangacopy.com/api/kb/web/searchcl/comics?offset=0&platform=2&limit=12&q={query}&q_type="
}
