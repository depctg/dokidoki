{
  "schemaVersion": 1,
  "id": "mangacopy",
  "name": "拷貝漫畫 · MangaCopy",
  "version": 6,
  "allowedHosts": [
    "s0.mangafunb.fun",
    "s3.mangafunb.fun",
    "sa.mangafunb.fun",
    "sb.mangafunb.fun",
    "sc.mangafunb.fun",
    "sd.mangafunb.fun",
    "se.mangafunb.fun",
    "sf.mangafunb.fun",
    "sg.mangafunb.fun",
    "sh.mangafunb.fun",
    "si.mangafunb.fun",
    "sj.mangafunb.fun",
    "sk.mangafunb.fun",
    "sl.mangafunb.fun",
    "sm.mangafunb.fun",
    "sn.mangafunb.fun",
    "so.mangafunb.fun",
    "sp.mangafunb.fun",
    "sq.mangafunb.fun",
    "sr.mangafunb.fun",
    "ss.mangafunb.fun",
    "st.mangafunb.fun",
    "sw.mangafunb.fun",
    "sx.mangafunb.fun",
    "sy.mangafunb.fun",
    "sz.mangafunb.fun",
    "www.mangacopy.com"
  ],
  "matchers": [
    {
      "kind": "site",
      "pattern": "^https://www\\.mangacopy\\.com/$",
      "priority": 0
    },
    {
      "kind": "directory",
      "pattern": "^https://www\\.mangacopy\\.com/(comics|search|recommend|newest)(\\?.*)?$",
      "priority": 0
    },
    {
      "kind": "directory",
      "pattern": "^https://www\\.mangacopy\\.com/api/kb/web/searchcl/comics\\?.*$",
      "priority": 0,
      "extractor": "search"
    },
    {
      "kind": "manga",
      "pattern": "^https://www\\.mangacopy\\.com/comic/[^/?]+$",
      "priority": 0
    },
    {
      "kind": "chapter",
      "pattern": "^https://www\\.mangacopy\\.com/comic/[^/?]+/chapter/[^/?]+$",
      "priority": 0
    }
  ],
  "extractors": {
    "directory": {
      "format": "renderedHTML",
      "rendering": {
        "readyXPath": "//div[contains(concat(' ',normalize-space(@class),' '),' exemptComic_Item ')]//a[.//p[@title]] | //*[@id='comic']//li[@class='page-total' and normalize-space(.)='/0']",
        "contentMode": "desktop"
      },
      "fields": {
        "title": {
          "path": "//title"
        },
        "mangaLinks": {
          "path": "//div[contains(concat(' ',normalize-space(@class),' '),' exemptComic_Item ')]//a[.//p[@title]]",
          "read": "attr:href",
          "fields": {
            "title": {
              "path": ".//p[@title]",
              "read": "attr:title"
            },
            "coverImage": {
              "path": "ancestor::div[contains(concat(' ',normalize-space(@class),' '),' exemptComic_Item ')][1]//img",
              "read": "attr:data-src",
              "fallback": "attr:src"
            },
            "author": {
              "path": "ancestor::div[contains(concat(' ',normalize-space(@class),' '),' exemptComic_Item ')][1]//span[contains(@class,'exemptComicItem-txt-span')]/a"
            }
          }
        },
        "next": {
          "path": "//li[@class='next']/a[starts-with(@href,'/comics?') or starts-with(@href,'/recommend?') or starts-with(@href,'/newest?')]",
          "read": "attr:href"
        },
        "sortByLinks": {
          "path": "//dl[dt[contains(.,'排序')]]//a",
          "read": "attr:href"
        }
      }
    },
    "manga": {
      "format": "renderedHTML",
      "rendering": {
        "readyXPath": "//div[contains(@class,'upLoop')]//div[contains(@class,'tab-content')]//a[contains(@href,'/chapter/')]",
        "contentMode": "desktop"
      },
      "fields": {
        "title": {
          "path": "//h6[@title]"
        },
        "author": {
          "path": "//span[contains(@class,'comicParticulars-right-txt')][a[contains(@href,'/author/')]]"
        },
        "coverImage": {
          "path": "//div[contains(@class,'comicParticulars-left-img')]/img",
          "read": "attr:data-src",
          "fallback": "attr:src"
        },
        "summary": {
          "path": "//p[@class=\"intro\"]"
        },
        "status": {
          "path": "//li[span[contains(.,'狀態')]]/span[contains(@class,'comicParticulars-right-txt')]"
        },
        "tags": {
          "path": "//span[contains(@class,'comicParticulars-tag')]/a",
          "regex": "^#?(.*)$",
          "group": 1
        },
        "chapterLinks": {
          "path": "//div[contains(@class,'upLoop')]//div[contains(@class,'tab-content')]//a[contains(@href,'/chapter/')]",
          "read": "attr:href"
        }
      }
    },
    "chapter": {
      "rendering": {
        "contentMode": "desktop",
        "readyXPath": "//span[@class='comicCount' and number(.) > 0]"
      },
      "session": {
        "mode": "scroll",
        "actionXPath": "//ul[contains(@class,'comicContent-list')]/li[1]"
      },
      "fields": {
        "title": {
          "path": "//title",
          "regex": "^.*? - (.*?) - ",
          "group": 1
        },
        "mangaLink": {
          "path": "//div[contains(@class,'comicContent-prev') and contains(@class,'list')]/a",
          "read": "attr:href"
        },
        "totalCount": {
          "path": "//span[@class='comicCount']"
        },
        "pageImages": {
          "path": "//ul[contains(@class,'comicContent-list')]//img",
          "read": "attr:data-src"
        }
      }
    },
    "search": {
      "format": "json",
      "fields": {
        "title": {
          "path": "message"
        },
        "mangaLinks": {
          "path": "results.list.*",
          "read": "attr:path_word",
          "urlTemplate": "https://www.mangacopy.com/comic/{value}",
          "fields": {
            "title": {
              "path": "name"
            },
            "coverImage": {
              "path": "cover"
            },
            "author": {
              "path": "author.*.name"
            },
            "tags": {
              "path": "theme.*.name"
            }
          }
        }
      },
      "pagination": {
        "offset": "results.offset",
        "limit": "results.limit",
        "total": "results.total",
        "parameter": "offset"
      }
    },
    "site": {
      "rendering": {
        "contentMode": "desktop",
        "readyXPath": "//main//a[@href='/recommend']"
      },
      "fields": {
        "title": {
          "path": "//title"
        },
        "directoryLinks": {
          "path": "//div[contains(@class,'index-all-icon-right')]/a[@href='/recommend' or @href='/comics' or @href='/newest']",
          "read": "attr:href",
          "fields": {
            "title": {
              "path": "../../div/h4"
            },
            "mangaLinks": {
              "path": "../../../div[contains(@class,'row')]//a[contains(@href,'/comic/') and .//p]",
              "read": "attr:href",
              "fields": {
                "title": {
                  "path": ".//p"
                },
                "coverImage": {
                  "path": ".//img",
                  "read": "attr:data-src",
                  "fallback": "attr:src"
                }
              }
            }
          }
        }
      }
    }
  },
  "browse": [
    {
      "title": "首頁",
      "url": "https://www.mangacopy.com/"
    }
  ],
  "searchURLTemplate": "https://www.mangacopy.com/api/kb/web/searchcl/comics?offset=0&platform=2&limit=12&q={query}&q_type="
}
