{
  "schemaVersion": 1,
  "id": "demo",
  "name": "Bundled reading room",
  "version": 2,
  "allowedHosts": [
    "demo.mangaviewer.local"
  ],
  "matchers": [
    {
      "kind": "directory",
      "pattern": "^https://demo\\.mangaviewer\\.local/catalog(\\?q=.*)?$",
      "priority": 0
    },
    {
      "kind": "manga",
      "pattern": "^https://demo\\.mangaviewer\\.local/series/[^/]+$",
      "priority": 0
    },
    {
      "kind": "chapter",
      "pattern": "^https://demo\\.mangaviewer\\.local/chapter/[^/]+$",
      "priority": 0
    }
  ],
  "extractors": {
    "directory": {
      "format": "html",
      "fields": {
        "title": {
          "path": "//h1"
        },
        "mangaLinks": {
          "path": "//a",
          "read": "attr:href"
        }
      }
    },
    "manga": {
      "format": "html",
      "fields": {
        "title": {
          "path": "//h1"
        },
        "author": {
          "path": "//p[@class=\"author\"]"
        },
        "summary": {
          "path": "//p[@class=\"summary\"]"
        },
        "coverImage": {
          "path": "//img",
          "read": "attr:src"
        },
        "chapterLinks": {
          "path": "//a",
          "read": "attr:href"
        }
      }
    },
    "chapter": {
      "format": "json",
      "fields": {
        "title": {
          "path": "title"
        },
        "mangaLink": {
          "path": "manga"
        },
        "pageImages": {
          "path": "pages.*"
        }
      }
    }
  },
  "browse": [
    {
      "title": "Reading room",
      "url": "https://demo.mangaviewer.local/catalog"
    }
  ],
  "searchURLTemplate": "https://demo.mangaviewer.local/catalog?q={query}"
}
