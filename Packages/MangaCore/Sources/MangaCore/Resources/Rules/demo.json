{
  "schemaVersion": 1,
  "id": "demo",
  "name": "Bundled reading room",
  "version": 6,
  "allowedHosts": [
    "demo.mangaviewer.local"
  ],
  "matchers": [
    {
      "kind": "directory",
      "pattern": "^https://demo\\.mangaviewer\\.local/catalog(\\?.*)?$",
      "priority": 0
    },
    {
      "kind": "manga",
      "pattern": "^https://demo\\.mangaviewer\\.local/series/[^/]+$",
      "priority": 0
    },
    {
      "kind": "chapter",
      "pattern": "^https://demo\\.mangaviewer\\.local/chapter/[^/]+$",
      "priority": 0
    }
  ],
  "extractors": {
    "directory": {
      "format": "html",
      "fields": {
        "title": {
          "path": "//h1"
        },
        "mangaLinks": {
          "path": "//a[@class=\"manga\"]",
          "read": "attr:href"
        },
        "sortByLinks": {
          "path": "//nav[@id=\"sortBy\"]/a",
          "read": "attr:href"
        },
        "selectedSortBy": {
          "path": "//nav[@id=\"sortBy\"]/a[@aria-current=\"true\"]",
          "read": "attr:href"
        },
        "sortOrderLinks": {
          "path": "//nav[@id=\"sortOrder\"]/a",
          "read": "attr:href"
        },
        "selectedSortOrder": {
          "path": "//nav[@id=\"sortOrder\"]/a[@aria-current=\"true\"]",
          "read": "attr:href"
        },
        "next": {
          "path": "//a[@rel='next']",
          "read": "attr:href"
        }
      }
    },
    "manga": {
      "format": "html",
      "fields": {
        "title": {
          "path": "//h1"
        },
        "author": {
          "path": "//p[@class=\"author\"]"
        },
        "summary": {
          "path": "//p[@class=\"summary\"]"
        },
        "coverImage": {
          "path": "//img",
          "read": "attr:src"
        },
        "chapterLinks": {
          "path": "//a",
          "read": "attr:href"
        },
        "rating": {
          "path": "//p[@class=\"rating\"]"
        },
        "status": {
          "path": "//p[@class=\"status\"]"
        },
        "tags": {
          "path": "//ul[@class=\"tags\"]/li"
        }
      }
    },
    "chapter": {
      "format": "json",
      "fields": {
        "title": {
          "path": "title"
        },
        "mangaLink": {
          "path": "manga"
        },
        "pageImages": {
          "path": "pages.*"
        }
      }
    }
  },
  "browse": [
    {
      "title": "Reading room",
      "url": "https://demo.mangaviewer.local/catalog"
    }
  ],
  "searchURLTemplate": "https://demo.mangaviewer.local/catalog?q={query}"
}
